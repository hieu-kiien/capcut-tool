{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CapCut Long Story Studio (Experimental)",
  "version": "0.0.1-experimental",
  "identifier": "com.capcut.longstorystudio.experimental",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CapCut Long Story Studio PRO v2.0",
        "width": 1600,
        "height": 960,
        "minWidth": 1280,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost;"
    }
  },
  "plugins": {}
}
